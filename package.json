{
  "name": "coding-jokes",
  "version": "3.0.0",
  "description": "A modern web application with 400+ programming jokes, emoji reactions, achievements, 3D effects, and personal stats tracking",
  "author": "Elizabeth Stein",
  "license": "MIT",
  "keywords": [
    "programming",
    "jokes",
    "humor",
    "web-app",
    "javascript",
    "gamification",
    "achievements",
    "3d-effects",
    "modern-design"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node tests/lint.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "pnpm lint && pnpm test && pnpm build",
    "security": "pnpm audit --audit-level high",
    "audit": "pnpm audit --audit-level high",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "dependencies": {
    "posthog-js": "^1.418.10",
    "vite": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forbiddenlink/coding-jokes"
  },
  "private": false,
  "devDependencies": {
    "@biomejs/biome": "^2.5.10"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/core": ">=2.8.0",
      "axios": ">=1.13.5",
      "dompurify": ">=3.4.13",
      "fast-uri": ">=3.1.2",
      "flatted": ">=3.3.4",
      "hono": ">=4.13.0",
      "lodash": ">=4.17.21",
      "minimatch": ">=10.2.5",
      "nanoid": "3.3.18",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.23",
      "protobufjs": ">=8.6.6",
      "rollup": ">=4.59.0",
      "undici": ">=7.28.0 <8",
      "vite": "8.2.2"
    }
  },
  "packageManager": "pnpm@10.18.0"
}
