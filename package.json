{
  "name": "coding-jokes",
  "version": "3.0.0",
  "description": "A modern web application with 400+ programming jokes, emoji reactions, achievements, 3D effects, and personal stats tracking",
  "author": "Elizabeth Stein",
  "license": "MIT",
  "keywords": [
    "programming",
    "jokes",
    "humor",
    "web-app",
    "javascript",
    "gamification",
    "achievements",
    "3d-effects",
    "modern-design"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node tests/lint.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run lint && npm run test && npm run build",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "dependencies": {
    "posthog-js": "^1.364.1",
    "vite": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forbiddenlink/coding-jokes"
  },
  "private": false,
  "devDependencies": {
    "@biomejs/biome": "^2.4.9"
  },
  "pnpm": {
    "overrides": {
      "picomatch": ">=4.0.4",
      "rollup": ">=4.59.0",
      "vite": ">=6.4.2",
      "protobufjs": ">=7.5.5",
      "fast-uri": ">=3.1.2",
      "axios": ">=1.13.5",
      "hono": ">=4.13.0",
      "minimatch": ">=10.2.5",
      "lodash": ">=4.17.21",
      "flatted": ">=3.3.4",
      "undici": ">=7.0.0"
    }
  }
}
